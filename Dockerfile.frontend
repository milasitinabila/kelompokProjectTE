# === TAHAP 1: Proses Build ===
FROM node:22-slim AS builder

WORKDIR /app

# Aktifkan pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy seluruh monorepo
COPY . .

# --- TAMBAHAN PENTING ---
# Ini memberitahu Docker untuk menerima variabel dari Railway
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
# --------------------------

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Build khusus aplikasi frontend (Vite)
RUN pnpm --filter ste-app... run build


# === TAHAP 2: Server Produksi ===
FROM node:22-slim

WORKDIR /app

RUN npm install -g serve

COPY --from=builder /app/artifacts/ste-app/dist ./dist

CMD ["sh", "-c", "serve -s dist -l tcp://0.0.0.0:${PORT:-8080}"]