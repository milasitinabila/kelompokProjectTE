# === TAHAP 1: Proses Build ===
# Ganti alpine menjadi slim
FROM node:22-slim AS builder

WORKDIR /app

# Aktifkan pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy seluruh monorepo
COPY . .

# Install dependencies (sekarang Rollup Linux standar akan otomatis terunduh)
RUN pnpm install --no-frozen-lockfile

# Build khusus aplikasi frontend (Vite)
RUN pnpm --filter ste-app... run build


# === TAHAP 2: Server Produksi (Sangat Ringan) ===
# Ganti alpine menjadi slim
FROM node:22-slim

WORKDIR /app

# Install 'serve'
RUN npm install -g serve

# Ambil HANYA folder hasil build (dist) dari Tahap 1
COPY --from=builder /app/artifacts/ste-app/dist ./dist

# Jalankan server
CMD ["sh", "-c", "serve -s dist -l tcp://0.0.0.0:${PORT:-8080}"]