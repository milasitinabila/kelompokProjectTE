# === TAHAP 1: Proses Build ===
FROM node:22-alpine AS builder

WORKDIR /app

# Aktifkan pnpm
RUN corepack enable && corepack prepare pnpm@latest --activate

# Copy seluruh monorepo agar dependencies terhubung dengan baik
COPY . .

# Install dependencies
RUN pnpm install --no-frozen-lockfile

# Build khusus aplikasi frontend (Vite)
RUN pnpm --filter ste-app... run build


# === TAHAP 2: Server Produksi (Sangat Ringan) ===
FROM node:22-alpine

WORKDIR /app

# Install 'serve', sebuah web server ringan khusus untuk file statis
RUN npm install -g serve

# Ambil HANYA folder hasil build (dist) dari Tahap 1, tinggalkan sisa kode yang berat
COPY --from=builder /app/artifacts/ste-app/dist ./dist

# Jalankan server di port yang diberikan oleh Railway
# Parameter "-s" sangat penting agar React/Vue Router (mode SPA) tidak error 404
CMD ["sh", "-c", "serve -s dist -l tcp://0.0.0.0:${PORT:-8080}"]